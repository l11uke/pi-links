# pi-links settings. The installer writes the live copy to
# /etc/pi-links/settings.env. This project has no secrets.

# IP address to listen on. 0.0.0.0 means every IPv4 interface.
PI_LINKS_BIND="0.0.0.0"

# TCP port for the page.
PI_LINKS_PORT="8090"

# Heading and browser tab title.
PI_LINKS_TITLE="Raspberry Pi"

# Absolute path of the file that renames, hides or adds links and tasks.
PI_LINKS_LINKS_FILE="/etc/pi-links/links.toml"

# Absolute path where the scan writes what it found.
PI_LINKS_DISCOVERY_FILE="/var/lib/pi-links/discovered.json"

# When the scan runs, as a systemd calendar expression: weekly, daily,
# "Sun 03:40" and so on. Check one with: systemd-analyze calendar "Sun 03:40"
PI_LINKS_SCAN_SCHEDULE="weekly"
